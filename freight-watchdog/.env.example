# Copy to a real .env (or set these as environment variables) to enable the
# optional LLM layer. Without it, the pipeline runs fully deterministically
# with template explanations -- identical verdicts, zero cost.

# --- Option A: any OpenAI-compatible endpoint -------------------------
# LLM_API_TYPE=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1   # optional (Groq, Together, ...)

# --- Option B: Azure OpenAI -------------------------------------------
# LLM_API_TYPE=azure
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21
